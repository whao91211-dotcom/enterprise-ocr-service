# ===== 应用 =====
APP_NAME=enterprise-ocr-service
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ===== OCR 模型服务 (OpenAI 兼容端点，本地 9052 隧道转发) =====
OCR_BASE_URL=http://127.0.0.1:9052/v1
# 真实模型名：internvl3（/v1/models 只显示 gpt-3.5-turbo，实际要用 internvl3）
OCR_MODEL=internvl3
OCR_API_KEY=
# 单槽 llama.cpp 推理慢，超时给足（实测一张图约 22s）
OCR_TIMEOUT_SECONDS=300
# 512 会被截断(finish=length)，1024 完整(finish=stop)
OCR_MAX_TOKENS=1024
OCR_TEMPERATURE=0.7
OCR_TOP_P=0.8
# 真实契约：InternVL 返回 CSV 多行，不是 JSON，必须 false
OCR_JSON_MODE=false
# 网络错误/5xx 的额外重试次数（总尝试=该值+1）；单槽串行，建议 0
OCR_RETRIES=0

# ===== 识别结果落盘 =====
# 每张销售图识别后落盘一个 .csv（+ .meta.json），平铺在此目录
OUTPUT_DIR=./output
# 允许上传的图片扩展名（逗号分隔）
ALLOWED_EXTS=jpg,jpeg,png,webp,bmp
# 上传大小上限（字节）
MAX_IMAGE_BYTES=20971520
