# ===== 应用 =====
APP_NAME=enterprise-ocr-service
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ===== OCR 模型服务 (OpenAI 兼容端点，本地 9052 隧道转发) =====
OCR_BASE_URL=http://127.0.0.1:9052/v1
# 真实模型名：internvl3（/v1/models 只显示 gpt-3.5-turbo，实际要用 internvl3）
OCR_MODEL=internvl3
OCR_API_KEY=
# 单槽 llama.cpp 推理慢，超时给足（实测一张图约 22s）
OCR_TIMEOUT_SECONDS=300
# 512 会被截断(finish=length)，1024 完整(finish=stop)
OCR_MAX_TOKENS=1024
OCR_TEMPERATURE=0.7
OCR_TOP_P=0.8
# 真实契约：InternVL 返回 CSV 多行，不是 JSON，必须 false
OCR_JSON_MODE=false
# 网络错误/5xx 的额外重试次数（总尝试=该值+1）；单槽串行，建议 0
OCR_RETRIES=0

# ===== 数据库 (PostgreSQL 16；本地无库可临时改 sqlite+aiosqlite:///./data/dev.db 仅限开发) =====
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# ===== 图片存储 =====
STORAGE_DIR=./data/images

# ===== 图片接入限制 =====
INGEST_MAX_BYTES=20971520
# 本地路径模式允许的根目录（逗号分隔；留空则 local_path 来源被拒绝）
INGEST_ALLOWED_ROOTS=
# URL/API 模式允许的主机白名单（逗号分隔；"*" 放行所有；留空则 url/api 来源被拒绝）
INGEST_URL_ALLOWLIST=
# 现有文件模块 API 模式：base 与可选 Bearer token（接入时配置）
INGEST_API_BASE_URL=
INGEST_API_TOKEN=
# 允许的图片扩展名（逗号分隔）
INGEST_ALLOWED_EXTS=jpg,jpeg,png,webp,bmp

# ===== 批量队列 =====
# 单张上传/联调时设 0 关掉 worker（否则 worker 写队列会和长 OCR 的 sqlite 写锁冲突）；批量导入时再开
BATCH_POLL_INTERVAL_SECONDS=0

# ===== 身份与审核 =====
# header: 企业网关注入 X-User-Id / X-User-Name；none: 本地联调(记为 local)
AUTH_MODE=none
# 原图访问签名时效（秒）
IMAGE_URL_TTL_SECONDS=300
# 签名密钥；留空且 AUTH_MODE=none 时原图接口不校验签名（仅限本地联调）
SIGNING_SECRET=
